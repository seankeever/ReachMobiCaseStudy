@model ReachMobiCaseStudy.Models.NewsSearchViewModel

@{
    ViewData["Title"] = "Search News";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="mb-3">Search News Articles</h1>
                    <p class="text-muted">
                        Search by keyword, date, or both.
                    </p>

                    @* Error message *@
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="Search" asp-controller="News" method="post">

                        <div class="mb-3">
                            <label asp-for="Keyword" class="form-label"></label>
                            <input asp-for="Keyword" class="form-control" placeholder="Try: technology, sports, elections" />
                            <span asp-validation-for="Keyword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Date Range</label>

                            <div class="row g-2">
                                <div class="col-6">
                                    <input asp-for="FromDate" type="date" class="form-control" />
                                    <small class="text-muted">From</small>
                                    <span asp-validation-for="FromDate" class="text-danger"></span>
                                </div>

                                <div class="col-6">
                                    <input asp-for="ToDate" type="date" class="form-control" />
                                    <small class="text-muted">To</small>
                                    <span asp-validation-for="ToDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary">
                                Search
                            </button>

                            <a asp-action="Stats" asp-controller="News" class="btn btn-outline-secondary">
                                View Session Stats
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
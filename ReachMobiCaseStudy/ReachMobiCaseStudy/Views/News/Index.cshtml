@model ReachMobiCaseStudy.Models.NewsSearchViewModel

@{
    ViewData["Title"] = "Search News";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h1 class="mb-3">Search News Articles</h1>
                    <p class="text-muted">
                        Search by keyword, date range, or advanced search options.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="Search" asp-controller="News" method="post">

                        <div class="mb-3">
                            <label asp-for="Keyword" class="form-label"></label>
                            <input asp-for="Keyword" class="form-control" placeholder="Try: technology, sports, elections" />
                            <span asp-validation-for="Keyword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Date Range</label>

                            <div class="row g-2">
                                <div class="col-6">
                                    <input asp-for="FromDate" type="date" class="form-control" />
                                    <small class="text-muted">From</small>
                                    <span asp-validation-for="FromDate" class="text-danger"></span>
                                </div>

                                <div class="col-6">
                                    <input asp-for="ToDate" type="date" class="form-control" />
                                    <small class="text-muted">To</small>
                                    <span asp-validation-for="ToDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="accordion mt-4 mb-4" id="advancedSearchAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingAdvanced">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdvanced" aria-expanded="false" aria-controls="collapseAdvanced">
                                        Advanced Search
                                    </button>
                                </h2>
                                <div id="collapseAdvanced" class="accordion-collapse collapse" aria-labelledby="headingAdvanced" data-bs-parent="#advancedSearchAccordion">
                                    <div class="accordion-body">

                                        <div class="mb-3">
                                            <label asp-for="ExactPhrase" class="form-label"></label>
                                            <input asp-for="ExactPhrase" class="form-control" placeholder="Example: exact phrase" />
                                            <span asp-validation-for="ExactPhrase" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="ExcludeWords" class="form-label"></label>
                                            <input asp-for="ExcludeWords" class="form-control" placeholder="Example: football baseball" />
                                            <small class="text-muted">Separate words with spaces.</small>
                                            <span asp-validation-for="ExcludeWords" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="TitleOnly" class="form-label"></label>
                                            <input asp-for="TitleOnly" class="form-control" placeholder="Only search article titles" />
                                            <span asp-validation-for="TitleOnly" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Domains" class="form-label"></label>
                                            <input asp-for="Domains" class="form-control" placeholder="Example: nytimes.com,bbc.com" />
                                            <span asp-validation-for="Domains" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="ExcludeDomains" class="form-label"></label>
                                            <input asp-for="ExcludeDomains" class="form-control" placeholder="Example: example.com,spam.com" />
                                            <span asp-validation-for="ExcludeDomains" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="SortBy" class="form-label"></label>
                                            <select asp-for="SortBy" class="form-select">
                                                <option value="publishedAt">Newest</option>
                                                <option value="relevancy">Relevancy</option>
                                                <option value="popularity">Popularity</option>
                                            </select>
                                            <span asp-validation-for="SortBy" class="text-danger"></span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary">
                                Search
                            </button>

                            <a asp-action="Stats" asp-controller="News" class="btn btn-outline-secondary">
                                View Session Stats
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}